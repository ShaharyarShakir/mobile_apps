{
  "name": "study-better-t",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "better-auth": "1.6.11",
      "@better-auth/expo": "1.6.11"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:native": "vp run --filter native dev",
    "dev:server": "vp run --filter server dev",
    "db:push": "vp run --filter @study-better-t/db db:push",
    "db:studio": "vp run --filter @study-better-t/db db:studio",
    "db:generate": "vp run --filter @study-better-t/db db:generate",
    "db:migrate": "vp run --filter @study-better-t/db db:migrate",
    "db:start": "vp run --filter @study-better-t/db db:start",
    "db:watch": "vp run --filter @study-better-t/db db:watch",
    "db:stop": "vp run --filter @study-better-t/db db:stop",
    "db:down": "vp run --filter @study-better-t/db db:down"
  },
  "dependencies": {
    "@study-better-t/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@study-better-t/config": "workspace:*",
    "@types/bun": "catalog:",
    "rolldown": "1.1.0",
    "typescript": "catalog:",
    "vite-plus": "0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "bun@1.3.13"
}
