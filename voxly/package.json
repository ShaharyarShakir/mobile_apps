{
  "name": "voxly",
  "main": "app/app.ts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:ios": "concurrently -k -n vite,ns \"bun run dev:server:ios\" \"wait-on tcp:5173 && bun run ios\"",
    "dev:android": "concurrently -k -n vite,ns \"bun run dev:server:android\" \"wait-on tcp:5173 && bun run android\"",
    "dev:server:ios": "vite serve -- --env.ios --env.hmr",
    "dev:server:android": "vite serve -- --env.android --env.hmr",
    "build:android": "vite build -- --env.android",
    "build:ios": "vite build -- --env.ios",
    "ios": "ns debug ios",
    "android": "ns debug android",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@nativescript-community/svelte-native": "~1.0.30",
    "@nativescript/core": "^9.0.0",
    "@valor/nativescript-websockets": "^2.0.3"
  },
  "devDependencies": {
    "@nativescript/android": "^9.0.5",
    "@nativescript/tailwind": "^4.0.9",
    "@nativescript/types": "~9.0.0",
    "@nativescript/vite": "^2.0.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "concurrently": "^10.0.5",
    "svelte": "^5.20.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^7.3.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@nativescript/core": "^9.0.0"
  }
}
